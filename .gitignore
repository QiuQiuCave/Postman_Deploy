# ==============================
# Python 相关
# ==============================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
*.egg-info/
*.egg
dist/
build/
*.so
*.dylib

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints/

# ==============================
# 开发环境 / IDE
# ==============================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# PyCharm
.idea/
*.iml
*.TXT

# macOS
.DS_Store

# ==============================
# 项目特定忽略
# ==============================
# 忽略所有临时 USD 文件
*.tmp.usd

*.h5
*.ckpt

# 忽略 MuJoCo 配置文件（按需取消注释）
# *.yaml
# *.xml

# 但保留特定配置文件（白名单）
!**/config/*.yaml
!**/config/*.xml

# ==============================
# 系统文件
# ==============================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# ==============================
# 日志和数据库
# ==============================
logs/
*.log
*.sqlite
*.db

# ==============================
# 策略文件备份 (手动回滚用, 不进版本控制)
# ==============================
*.bak_*
*.old_*.onnx
*.old_*.pt

# ==============================
# uv / venv / external SDK clones
# ==============================
.venv/
.venv-r2v2/
artifacts/
external/

# Separately supplied simulation resources and generated run assets.
/r2v2_description/source/
/r2v2_description/visuals/
*.pt
*.onnx
*.npz
*.mp4
*.webm
/output/

